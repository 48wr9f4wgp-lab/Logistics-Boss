# FLOTRA native release inputs
# Copy to godot/.native-release.env and fill locally.
# Never commit the real file or signing credentials.

# iOS — required before a production iOS export preset can be finalized.
LOGISTICS_BOSS_IOS_TEAM_ID=
LOGISTICS_BOSS_IOS_BUNDLE_ID=

# Android — required before a production Android export preset can be finalized.
LOGISTICS_BOSS_ANDROID_PACKAGE=

# Android release signing — Godot-supported environment variable names.
GODOT_ANDROID_KEYSTORE_RELEASE_PATH=
GODOT_ANDROID_KEYSTORE_RELEASE_USER=
GODOT_ANDROID_KEYSTORE_RELEASE_PASSWORD=
